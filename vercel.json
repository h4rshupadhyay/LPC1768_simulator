{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://lpc1768-simulator.onrender.com/api/:path*" },
    { "source": "/board/:path*", "destination": "https://lpc1768-simulator.onrender.com/board/:path*" },
    { "source": "/assets/board.jpg", "destination": "https://lpc1768-simulator.onrender.com/assets/board.jpg" }
  ]
}
